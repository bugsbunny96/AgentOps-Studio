# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agentops_studio

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:<password>@<host>:<port>

# ── JWT (generate with: openssl rand -base64 64) ──────────────────────────────
JWT_ACCESS_SECRET=replace_with_64_char_random_string_minimum_32_chars_required
JWT_REFRESH_SECRET=replace_with_different_64_char_random_string_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Email (Resend — https://resend.com) ───────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@agentops.studio

# ── AI Stack ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx

# ── Vapi (https://vapi.ai) ────────────────────────────────────────────────────
VAPI_API_KEY=xxxxxxxxxxxxxxxxxxxx
VAPI_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Vapi tool IDs — create these in Vapi Dashboard → Tools, then paste the IDs here
VAPI_TOOL_ID_END_CALL=           # ID of the 'end_receptionist_call' server tool
VAPI_TOOL_ID_SUBMIT_ORDER=       # ID of the 'submit_order' server tool
VAPI_STRUCTURED_OUTPUT_ID=       # ID of the electrical-shop-call-summary structured output schema

# Separate secret for Vapi tool-call webhooks (x-webhook-secret header)
# Different from VAPI_WEBHOOK_SECRET — used for POST /api/v1/orders/submit
VAPI_TOOL_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── Sarvam TTS Bridge (opt-in custom voice) ───────────────────────────────────
# Leave SARVAM_BRIDGE_URL blank to use Vapi native Naina V2 voice instead
SARVAM_API_KEY=
SARVAM_BRIDGE_URL=               # e.g. https://tts.yourdomain.com (your deployed bridge)
TTS_MODEL=bulbul:v3
TTS_LANGUAGE_CODE=hi-IN
TTS_SPEAKER=shubh

# ── Vobiz SIP Trunk (primary telephony — https://vobiz.ai) ───────────────────
VOBIZ_SIP_DOMAIN=                # e.g. xyz.sip.vobiz.ai
VOBIZ_AUTH_USERNAME=             # from Vobiz console → SIP Credentials
VOBIZ_AUTH_PASSWORD=
VOBIZ_GATEWAY_IP=                # from Vobiz console → Gateway Settings
VOBIZ_PHONE_NUMBER=              # E.164 format, e.g. +918XXXXXXXXX

# ── Exotel (fallback telephony — https://exotel.com) ─────────────────────────
EXOTEL_API_KEY=xxxxxxxxxxxxxxxxxxxx
EXOTEL_API_TOKEN=xxxxxxxxxxxxxxxxxxxx
EXOTEL_SID=xxxxxxxxxxxxxxxxxxxx
EXOTEL_CONNECTOR_URL=            # URL of your deployed Exotel-Vapi bridge service

# ── Stripe (https://dashboard.stripe.com) ────────────────────────────────────
# Secret key — use sk_test_... in dev/staging, sk_live_... in production
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Primary price IDs (fallback — used if INR variants below are not set)
# Create in Stripe Dashboard → Products → Add product → Add price
STRIPE_STARTER_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_GROWTH_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx

# INR-denominated price IDs — create separate prices with currency=INR in
# Stripe Dashboard. When these are set they REPLACE the primary IDs above
# so Indian customers are billed in ₹. The currency is baked into the Stripe
# Price object — no currency param is needed on the checkout session.
STRIPE_STARTER_PRICE_ID_INR=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_GROWTH_PRICE_ID_INR=price_xxxxxxxxxxxxxxxxxxxx
