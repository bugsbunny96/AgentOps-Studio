# Frontend environment variables
# Copy to .env.local for local development (never commit .env.local)

# Backend API URL (proxied in dev via Vite, set for production builds)
VITE_API_URL=http://localhost:3001

# ── Sentry (https://sentry.io) ────────────────────────────────────────────────
# Get from: Sentry Dashboard → Settings → Projects → <project> → Client Keys (DSN)
# Leave empty in local dev — Sentry is disabled when VITE_SENTRY_DSN is absent or DEV=true
VITE_SENTRY_DSN=https://xxxx@oXXX.ingest.sentry.io/YYYY

# Optional — shown as the release tag in Sentry (injected by CI from git SHA)
VITE_APP_VERSION=0.1.0

# ── Sentry source-map upload (build-time only, set in CI secrets NOT .env) ───
# SENTRY_AUTH_TOKEN=sntrys_xxxx      ← set in GitHub Actions secrets, never here
# SENTRY_ORG=agentops-studio         ← your Sentry org slug
# SENTRY_PROJECT=agentops-frontend   ← your Sentry project slug
